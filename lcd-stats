#!/usr/bin/env python3
"""Render system stats to the Zettlab front LCD (eDP-1, 172x640 portrait)."""
import glob, os, socket, subprocess, sys, time
from PIL import Image, ImageDraw, ImageFont

FB = "/dev/fb0"
PW, PH, STRIDE, BPP = 172, 640, 704, 4      # panel is portrait
CW, CH = PH, PW                              # canvas is landscape 640x172
ROTATE = Image.ROTATE_270                    # flip to ROTATE_90 if upside down
INTERVAL = 5
SMART_EVERY = 12                             # smartctl is slow; poll it less often

MONO = "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf"
SANS = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
n_xl = ImageFont.truetype(MONO, 31)          # numbers
n_lg = ImageFont.truetype(MONO, 24)
n_md = ImageFont.truetype(MONO, 18)
n_sm = ImageFont.truetype(MONO, 15)
l_sm = ImageFont.truetype(SANS, 12)          # labels
l_xs = ImageFont.truetype(SANS, 10)

BG      = (9, 11, 16)
CARD    = (20, 24, 33)
CARD_HI = (30, 35, 47)
LABEL   = (118, 126, 145)
TEXT    = (226, 230, 240)
ACCENT  = (86, 160, 255)
OK      = (72, 210, 140)
WARN    = (255, 176, 58)
HOT     = (255, 88, 82)

C1 = (6, 6, 124, 166)            # storage card
C2 = (130, 6, 398, 166)          # meters / drives / fans card
C3 = (404, 6, 634, 166)          # identity card

REAL_FS = {"ext4", "ext3", "xfs", "btrfs", "zfs", "f2fs", "jfs", "reiserfs"}


def hwmon_named(name):
    for d in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        try:
            if open(os.path.join(d, "name")).read().strip() == name:
                yield d
        except OSError:
            pass


HW = next(hwmon_named("zettlab_d8_fans"), None)


def read_int(p):
    try:
        return int(open(p).read().strip())
    except Exception:
        return None


def cpu_temp():
    for d in hwmon_named("coretemp"):
        v = read_int(os.path.join(d, "temp1_input"))
        if v:
            return v / 1000.0
    return None


_prev_cpu = None


def cpu_busy():
    global _prev_cpu
    vals = [int(x) for x in open("/proc/stat").readline().split()[1:8]]
    idle, total = vals[3] + vals[4], sum(vals)
    if _prev_cpu is None:
        _prev_cpu = (idle, total)
        return 0.0
    di, dt = idle - _prev_cpu[0], total - _prev_cpu[1]
    _prev_cpu = (idle, total)
    return 0.0 if dt <= 0 else max(0.0, min(100.0, 100.0 * (dt - di) / dt))


def fans():
    if not HW:
        return []
    return [(read_int(f"{HW}/fan{n}_input"), read_int(f"{HW}/pwm{n}")) for n in (1, 2, 3)]


def disk_temps():
    res = []
    for dev in sorted(glob.glob("/dev/sd[a-z]")):
        try:
            out = subprocess.run(["smartctl", "-A", dev], capture_output=True,
                                 text=True, timeout=8).stdout
            for line in out.splitlines():
                p = line.split()
                if p and p[0] in ("194", "190") and len(p) >= 10:
                    res.append((dev[-3:], int(p[9])))
                    break
        except Exception:
            pass
    return res


def nvme_temps():
    res = []
    for d in hwmon_named("nvme"):
        v = read_int(os.path.join(d, "temp1_input"))
        if v:
            res.append((f"nv{len(res)}", v // 1000))
    return res


def storage():
    used = total = 0
    seen = set()
    for line in open("/proc/mounts"):
        parts = line.split()
        if len(parts) < 3 or parts[2] not in REAL_FS:
            continue
        try:
            st = os.statvfs(parts[1])
        except OSError:
            continue
        key = (st.f_blocks, st.f_frsize, st.f_fsid)
        if not st.f_blocks or key in seen:
            continue
        seen.add(key)
        total += st.f_blocks * st.f_frsize
        used += (st.f_blocks - st.f_bfree) * st.f_frsize
    return used, total


def human(n):
    return f"{n / 1e12:.1f}TB" if n >= 1e12 else f"{n / 1e9:.0f}GB"


def mem():
    m = {}
    for line in open("/proc/meminfo"):
        k, v = line.split(":", 1)
        m[k] = int(v.split()[0])
    total = m["MemTotal"]
    avail = m.get("MemAvailable", m["MemFree"])
    return (total - avail) / 1048576.0, total / 1048576.0


def ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("192.168.0.1", 80))
        a = s.getsockname()[0]
        s.close()
        return a
    except Exception:
        return "-"


def uptime():
    s = int(float(open("/proc/uptime").read().split()[0]))
    d, s = divmod(s, 86400)
    h, s = divmod(s, 3600)
    return f"{d}d {h}h" if d else f"{h}h {s // 60}m"


def heat(t, warm, hot):
    if t is None:
        return LABEL
    return HOT if t >= hot else WARN if t >= warm else OK


def frame(hdd):
    img = Image.new("RGB", (CW, CH), BG)
    d = ImageDraw.Draw(img)

    def ctext(cx, y, txt, font, fill):
        d.text((cx - d.textlength(txt, font=font) / 2, y), txt, font=font, fill=fill)

    def rtext(x, y, txt, font, fill):
        d.text((x - d.textlength(txt, font=font), y), txt, font=font, fill=fill)

    def meter(x, y, w, h, frac, col):
        d.rounded_rectangle([x, y, x + w, y + h], radius=h // 2, fill=CARD_HI)
        fw = int(w * max(0.0, min(frac, 1.0)))
        if fw > h:
            d.rounded_rectangle([x, y, x + fw, y + h], radius=h // 2, fill=col)
        elif fw > 0:
            d.ellipse([x, y, x + h, y + h], fill=col)

    for card in (C1, C2, C3):
        d.rounded_rectangle(card, radius=10, fill=CARD)

    nvme = nvme_temps()

    # ---- card 1: storage ------------------------------------------------
    used, total = storage()
    frac = used / total if total else 0
    cx, cy, r = (C1[0] + C1[2]) // 2, 74, 42
    box = [cx - r, cy - r, cx + r, cy + r]
    d.arc(box, 130, 410, fill=CARD_HI, width=10)
    if frac > 0:
        col = HOT if frac > .9 else WARN if frac > .75 else ACCENT
        d.arc(box, 130, 130 + int(280 * frac), fill=col, width=10)
    ctext(cx, 14, "STORAGE", l_xs, LABEL)
    ctext(cx, cy - 22, f"{frac * 100:.0f}", n_xl, TEXT)
    ctext(cx, cy + 12, "%", l_sm, LABEL)
    ctext(cx, 126, human(used), n_md, TEXT)
    ctext(cx, 147, f"of {human(total)}", l_xs, LABEL)

    # ---- card 2: meters, drives, fans -----------------------------------
    x0, x1 = C2[0] + 14, C2[2] - 14
    w = x1 - x0

    ct = cpu_temp()
    busy = cpu_busy()
    cv = f"{ct:.0f}" if ct else "--"
    d.text((x0, 16), "CPU", font=l_sm, fill=LABEL)
    d.text((x0 + 42, 10), cv, font=n_lg, fill=heat(ct, 70, 85))
    d.text((x0 + 44 + d.textlength(cv, font=n_lg), 18), "C", font=l_sm,
           fill=heat(ct, 70, 85))
    rtext(x1, 14, f"{busy:.0f}%", n_md, TEXT)
    meter(x0, 40, w, 7, busy / 100, ACCENT)

    mu, mt = mem()
    d.text((x0, 58), "MEM", font=l_sm, fill=LABEL)
    d.text((x0 + 42, 54), f"{mu:.1f}/{mt:.0f}G", font=n_md, fill=TEXT)
    rtext(x1, 56, f"{100 * mu / mt:.0f}%", n_md, TEXT)
    meter(x0, 78, w, 7, mu / mt, OK)

    cells = [(n, t, 47, 55) for n, t in hdd] + [(n, t, 60, 70) for n, t in nvme]
    CELL, PER, Y0 = 66, 4, 94
    for i, (name, temp, warm, hot) in enumerate(cells[:8]):
        px = x0 + (i % PER) * CELL
        py = Y0 + (i // PER) * 20
        col = heat(temp, warm, hot)
        d.ellipse([px, py + 6, px + 6, py + 12], fill=col)
        d.text((px + 11, py), name, font=l_xs, fill=LABEL)
        d.text((px + 11, py + 8), str(temp), font=n_sm, fill=col)

    fy = 140
    d.text((x0, fy + 3), "FANS", font=l_xs, fill=LABEL)
    for lab, (rpm, pwm), px in zip(("D1", "D2", "CPU"),
                                   fans() or [(None, None)] * 3,
                                   (x0 + 46, x0 + 130, x0 + 210)):
        col = OK if rpm else HOT
        d.text((px, fy + 4), lab, font=l_xs, fill=LABEL)
        d.text((px + 26, fy), f"{rpm if rpm is not None else 0}", font=n_sm, fill=col)

    # ---- card 3: identity -----------------------------------------------
    rx = C3[2] - 16
    rtext(rx, 16, socket.gethostname(), n_xl, ACCENT)
    rtext(rx, 56, ip(), n_md, TEXT)
    rtext(rx, 78, f"up {uptime()}", l_xs, LABEL)
    rtext(rx, 102, time.strftime("%H:%M"), n_xl, TEXT)
    rtext(rx, 142, time.strftime("%a %d %b"), l_xs, LABEL)
    return img


def blit(img):
    img = img.transpose(ROTATE)                       # -> 172x640
    raw = img.tobytes("raw", "BGRX")                  # i915 XRGB8888 LE
    row = PW * BPP
    with open(FB, "r+b", buffering=0) as fh:
        for y in range(PH):
            fh.seek(y * STRIDE)
            fh.write(raw[y * row:(y + 1) * row])


if __name__ == "__main__":
    once = "--once" in sys.argv
    hdd, tick = disk_temps(), 0
    cpu_busy()
    while True:
        try:
            if tick % SMART_EVERY == 0 and tick:
                hdd = disk_temps()
            blit(frame(hdd))
        except Exception as e:
            print("err:", e, flush=True)
        if once:
            break
        tick += 1
        time.sleep(INTERVAL)
