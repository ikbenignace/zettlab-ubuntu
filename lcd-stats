#!/usr/bin/env python3
"""Render a system dashboard to the Zettlab front LCD (eDP-1, 172x640 portrait).

Header (host / health badge / clock / IP), four stat cards (storage, CPU,
memory, fans), and one card per drive with SMART health and temperature.
Drives are discovered at runtime, so the strip scales to a full chassis.
"""
import glob, os, re, socket, subprocess, sys, time
from PIL import Image, ImageDraw, ImageFont

FB = "/dev/fb0"
PW, PH, STRIDE, BPP = 172, 640, 704, 4
CW, CH = PH, PW                                  # canvas is landscape 640x172
ROTATE = Image.ROTATE_270
INTERVAL = 5
SMART_EVERY = 24

# Inter matches the reference design; DejaVu is the fallback if it is absent.
INTER = "/usr/share/fonts/opentype/inter/Inter-%s.otf"
DEJAVU = "/usr/share/fonts/truetype/dejavu/DejaVuSans-%s.ttf"


def F(weight, size, fallback="Bold"):
    for path in (INTER % weight, DEJAVU % fallback):
        try:
            return ImageFont.truetype(path, size)
        except OSError:
            continue
    return ImageFont.load_default()


f_clock  = F("Bold", 14)          # 20:46 — matches the IP
f_host   = F("ExtraBold", 14)     # NAS — matches the IP
f_ip     = F("SemiBold", 14)      # 192.168.0.50
f_val    = F("Bold", 23)          # 45 / 1.1
f_val_sm = F("Bold", 16)          # 0% / 4%
f_fan    = F("Bold", 16)          # 797
f_drive  = F("Bold", 15)          # 41
f_lbl    = F("SemiBold", 11)      # STORAGE / CPU / MEMORY / FANS
f_tiny   = F("Medium", 8)         # USED / TOTAL / UTILIZATION / rpm
f_unit   = F("SemiBold", 9)       # degrees, /28G
f_cap    = F("Bold", 12)          # 14GB / 982GB
f_ring   = F("Bold", 13)          # ring percentage

BG        = (5, 7, 11)
CARD      = (15, 19, 24)
CARD_EDGE = (27, 33, 41)
TRACK     = (30, 37, 48)
WHITE     = (241, 245, 249)
GREY      = (139, 149, 165)
GREEN     = (52, 211, 153)
AMBER     = (245, 158, 11)
RED       = (239, 68, 68)
RED_CARD  = (42, 15, 17)
RED_EDGE  = (127, 29, 29)
DIVIDER   = (36, 43, 54)

M = 6                                            # outer margin
HEAD = (M, 3, CW - M, 33)
ROW2_T, ROW2_B = 37, 111
ROW3_T, ROW3_B = 115, CH - 3

REAL_FS = {"ext4", "ext3", "xfs", "btrfs", "zfs", "f2fs", "jfs", "reiserfs"}
BAD_ATTRS = ("5", "197", "198")


# ---------------------------------------------------------------- sensors

def hwmon_named(name):
    for d in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        try:
            if open(os.path.join(d, "name")).read().strip() == name:
                yield d
        except OSError:
            pass


HW = next(hwmon_named("zettlab_d8_fans"), None)


def read_int(p):
    try:
        return int(open(p).read().strip())
    except Exception:
        return None


def cpu_temp():
    for d in hwmon_named("coretemp"):
        v = read_int(os.path.join(d, "temp1_input"))
        if v:
            return v / 1000.0
    return None


_prev_cpu = None


def cpu_busy():
    global _prev_cpu
    vals = [int(x) for x in open("/proc/stat").readline().split()[1:8]]
    idle, total = vals[3] + vals[4], sum(vals)
    if _prev_cpu is None:
        _prev_cpu = (idle, total)
        return 0.0
    di, dt = idle - _prev_cpu[0], total - _prev_cpu[1]
    _prev_cpu = (idle, total)
    return 0.0 if dt <= 0 else max(0.0, min(100.0, 100.0 * (dt - di) / dt))


def fans():
    if not HW:
        return [(None, None)] * 3
    return [(read_int(f"{HW}/fan{n}_input"), read_int(f"{HW}/pwm{n}")) for n in (1, 2, 3)]


def discover():
    devs = [(p, os.path.basename(p)) for p in sorted(glob.glob("/dev/sd[a-z]"))]
    for p in sorted(glob.glob("/dev/nvme[0-9]n[0-9]")):
        m = re.search(r"nvme(\d+)n", p)
        devs.append((p, f"nv{m.group(1)}" if m else os.path.basename(p)))
    return devs


_last = {}


def probe(path, name):
    try:
        r = subprocess.run(["smartctl", "-H", "-A", "-n", "standby", path],
                           capture_output=True, text=True, timeout=12)
    except Exception:
        return _last.get(name, (None, "unknown"))
    out = r.stdout
    if "Device is in" in out and "STANDBY" in out.upper():
        return _last.get(name, (None, "unknown"))

    temp, health = None, "unknown"
    if re.search(r"self-assessment test result:\s*PASSED", out) or \
            "SMART Health Status: OK" in out:
        health = "ok"
    if re.search(r"self-assessment test result:\s*FAILED", out) or \
            "SMART Health Status: FAILED" in out:
        health = "bad"

    for line in out.splitlines():
        p = line.split()
        if len(p) >= 10 and p[0].isdigit():
            if p[0] in ("194", "190") and temp is None:
                try:
                    temp = int(p[9])
                except ValueError:
                    pass
            if p[0] in BAD_ATTRS and health == "ok":
                try:
                    if int(p[9].split()[0]) > 0:
                        health = "warn"
                except ValueError:
                    pass
        if temp is None and line.startswith("Temperature:"):
            m = re.search(r"(\d+)\s*Celsius", line)
            if m:
                temp = int(m.group(1))
        if health == "ok" and line.startswith("Critical Warning:") and \
                line.split(":")[1].strip() not in ("0x00", "0"):
            health = "warn"
    if temp is None:
        temp = _last.get(name, (None, None))[0]
    _last[name] = (temp, health)
    return temp, health


def drives():
    return [(n, *probe(p, n)) for p, n in discover()]


def drive_limits(name):
    return (60, 72) if name.startswith("nv") else (47, 55)


def temp_col(name, temp):
    if temp is None:
        return GREY
    warm, hot = drive_limits(name)
    return RED if temp >= hot else AMBER if temp >= warm else GREEN


HEALTH_COL = {"ok": GREEN, "warn": AMBER, "bad": RED, "unknown": GREY}


def storage():
    used = total = 0
    seen = set()
    for line in open("/proc/mounts"):
        p = line.split()
        if len(p) < 3 or p[2] not in REAL_FS:
            continue
        try:
            st = os.statvfs(p[1])
        except OSError:
            continue
        key = (st.f_blocks, st.f_frsize, st.f_fsid)
        if not st.f_blocks or key in seen:
            continue
        seen.add(key)
        total += st.f_blocks * st.f_frsize
        used += (st.f_blocks - st.f_bfree) * st.f_frsize
    return used, total


def human(n):
    return f"{n / 1e12:.1f}TB" if n >= 1e12 else f"{n / 1e9:.0f}GB"


def mem():
    m = {}
    for line in open("/proc/meminfo"):
        k, v = line.split(":", 1)
        m[k] = int(v.split()[0])
    t = m["MemTotal"]
    return (t - m.get("MemAvailable", m["MemFree"])) / 1048576.0, t / 1048576.0


def ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("192.168.0.1", 80))
        a = s.getsockname()[0]
        s.close()
        return a
    except Exception:
        return "-"


def uptime():
    s = int(float(open("/proc/uptime").read().split()[0]))
    d, s = divmod(s, 86400)
    h, s = divmod(s, 3600)
    return f"{d}d {h}h" if d else f"{h}h {s // 60}m"


def cpu_col(t):
    return GREY if t is None else RED if t >= 85 else AMBER if t >= 70 else GREEN


# ---------------------------------------------------------------- drawing

def frame(dr):
    img = Image.new("RGB", (CW, CH), BG)
    d = ImageDraw.Draw(img)

    def tw(txt, font):
        return d.textlength(txt, font=font)

    def ctext(cx, y, txt, font, fill):
        d.text((cx - tw(txt, font) / 2, y), txt, font=font, fill=fill)

    def rtext(x, y, txt, font, fill):
        d.text((x - tw(txt, font), y), txt, font=font, fill=fill)

    def card(box, fill=CARD, edge=CARD_EDGE):
        d.rounded_rectangle(box, radius=7, fill=fill, outline=edge, width=1)

    def bar(x, y, w, h, frac, col):
        d.rounded_rectangle([x, y, x + w, y + h], radius=h // 2, fill=TRACK)
        fw = int(w * max(0.0, min(frac, 1.0)))
        if fw >= h:
            d.rounded_rectangle([x, y, x + fw, y + h], radius=h // 2, fill=col)
        elif fw > 0:
            d.ellipse([x, y, x + h, y + h], fill=col)

    # --- tiny glyphs, approximations of the mockup's icons ---------------
    def ic_storage(x, y, c=GREY):
        for i in range(3):
            d.ellipse([x, y + i * 4, x + 11, y + 6 + i * 4], outline=c)

    def ic_cpu(x, y, c=GREY):
        d.rounded_rectangle([x + 2, y + 2, x + 11, y + 11], radius=2, outline=c)
        d.rectangle([x + 5, y + 5, x + 8, y + 8], outline=c)
        for o in (4, 8):
            d.line([(x + o, y), (x + o, y + 2)], fill=c)
            d.line([(x + o, y + 11), (x + o, y + 13)], fill=c)

    def ic_mem(x, y, c=GREY):
        d.rounded_rectangle([x, y + 2, x + 13, y + 10], radius=1, outline=c)
        for o in (3, 6, 9):
            d.line([(x + o, y + 5), (x + o, y + 8)], fill=c)

    def ic_fan(x, y, c=GREY):
        d.ellipse([x + 5, y + 5, x + 8, y + 8], outline=c)
        for dx, dy in ((0, -5), (5, 3), (-5, 3)):
            d.ellipse([x + 5 + dx - 3, y + 6 + dy - 3,
                       x + 5 + dx + 3, y + 6 + dy + 3], outline=c)

    def ic_globe(x, y, c=GREY):
        d.ellipse([x, y, x + 11, y + 11], outline=c)
        d.ellipse([x + 3, y, x + 8, y + 11], outline=c)
        d.line([(x, y + 5), (x + 11, y + 5)], fill=c)

    def ic_clock(x, y, c=GREY):
        d.ellipse([x, y, x + 9, y + 9], outline=c)
        d.line([(x + 4, y + 4), (x + 4, y + 2)], fill=c)
        d.line([(x + 4, y + 4), (x + 6, y + 5)], fill=c)

    # ---- header ---------------------------------------------------------
    card(HEAD)
    hy = HEAD[1]
    d.ellipse([M + 10, hy + 12, M + 16, hy + 18], fill=GREEN)
    host = socket.gethostname().upper()
    d.text((M + 24, hy + 8), host, font=f_host, fill=WHITE)

    bad = sum(1 for _, _, h in dr if h == "bad")
    warn = sum(1 for _, _, h in dr if h == "warn")
    if dr:
        msg = f"{bad} FAILING" if bad else f"{warn} WARNING" if warn else f"{len(dr)} OK"
        col = RED if bad else AMBER if warn else GREEN
        bx = M + 24 + tw(host, f_host) + 10
        bw = tw(msg, f_lbl) + 24
        d.rounded_rectangle([bx, hy + 7, bx + bw, hy + 23], radius=8, outline=col)
        d.ellipse([bx + 6, hy + 12, bx + 12, hy + 18], outline=col)
        d.line([(bx + 9, hy + 13), (bx + 9, hy + 16)], fill=col)
        d.text((bx + 17, hy + 10), msg, font=f_lbl, fill=col)

    ctext(CW // 2, hy + 8, time.strftime("%H:%M"), f_clock, WHITE)
    addr = ip()
    d.ellipse([CW - M - 16, hy + 12, CW - M - 10, hy + 18], fill=GREEN)
    rtext(CW - M - 22, hy + 8, addr, f_ip, WHITE)
    ic_globe(CW - M - 28 - tw(addr, f_ip) - 12, hy + 9)

    # ---- row 2: four cards ----------------------------------------------
    gap, n = 5, 4
    total_w = (CW - M) - M
    cw_ = (total_w - gap * (n - 1)) // n
    xs = [M + i * (cw_ + gap) for i in range(n)]

    # storage
    x = xs[0]
    card((x, ROW2_T, x + cw_, ROW2_B))
    ic_storage(x + 9, ROW2_T + 8)
    d.text((x + 26, ROW2_T + 8), "STORAGE", font=f_lbl, fill=WHITE)
    used, tot = storage()
    frac = used / tot if tot else 0
    rcx, rcy, rr = x + 36, ROW2_T + 47, 21
    d.ellipse([rcx - rr, rcy - rr, rcx + rr, rcy + rr], outline=TRACK, width=6)
    if frac > 0:
        col = RED if frac > .9 else AMBER if frac > .75 else GREEN
        d.arc([rcx - rr, rcy - rr, rcx + rr, rcy + rr], -90,
              -90 + max(6, int(360 * frac)), fill=col, width=6)
    ctext(rcx, rcy - 7, f"{frac * 100:.0f}%", f_ring, WHITE)
    tx = x + 66
    d.text((tx, ROW2_T + 23), "USED", font=f_tiny, fill=GREY)
    d.text((tx, ROW2_T + 31), human(used), font=f_cap, fill=WHITE)
    d.line([(tx, ROW2_T + 48), (x + cw_ - 10, ROW2_T + 48)], fill=DIVIDER)
    d.text((tx, ROW2_T + 52), "TOTAL", font=f_tiny, fill=GREY)
    d.text((tx, ROW2_T + 60), human(tot), font=f_cap, fill=WHITE)

    # cpu
    x = xs[1]
    card((x, ROW2_T, x + cw_, ROW2_B))
    ic_cpu(x + 9, ROW2_T + 7)
    d.text((x + 26, ROW2_T + 8), "CPU", font=f_lbl, fill=WHITE)
    ct, busy = cpu_temp(), cpu_busy()
    cv = f"{ct:.0f}" if ct else "--"
    d.text((x + 10, ROW2_T + 28), cv, font=f_val, fill=cpu_col(ct))
    d.text((x + 12 + tw(cv, f_val), ROW2_T + 38), "°C", font=f_unit, fill=cpu_col(ct))
    dv = x + int(cw_ * 0.64)
    d.line([(dv, ROW2_T + 24), (dv, ROW2_T + 54)], fill=DIVIDER)
    d.text((dv + 9, ROW2_T + 26), "USAGE", font=f_tiny, fill=GREY)
    d.text((dv + 9, ROW2_T + 35), f"{busy:.0f}%", font=f_val_sm, fill=WHITE)
    bar(x + 10, ROW2_T + 62, cw_ - 20, 6, busy / 100, GREEN)

    # memory
    x = xs[2]
    card((x, ROW2_T, x + cw_, ROW2_B))
    ic_mem(x + 9, ROW2_T + 7)
    d.text((x + 26, ROW2_T + 8), "MEMORY", font=f_lbl, fill=WHITE)
    mu, mt = mem()
    mv = f"{mu:.1f}"
    d.text((x + 10, ROW2_T + 28), mv, font=f_val, fill=WHITE)
    d.text((x + 12 + tw(mv, f_val), ROW2_T + 38), f"/{mt:.0f}G", font=f_unit, fill=GREY)
    dv = x + int(cw_ * 0.64)
    d.line([(dv, ROW2_T + 24), (dv, ROW2_T + 54)], fill=DIVIDER)
    d.text((dv + 9, ROW2_T + 26), "USAGE", font=f_tiny, fill=GREY)
    d.text((dv + 9, ROW2_T + 35), f"{100 * mu / mt:.0f}%", font=f_val_sm, fill=WHITE)
    bar(x + 10, ROW2_T + 62, cw_ - 20, 6, mu / mt, GREEN)

    # fans
    x = xs[3]
    card((x, ROW2_T, x + cw_, ROW2_B))
    ic_fan(x + 8, ROW2_T + 7)
    d.text((x + 26, ROW2_T + 8), "FANS", font=f_lbl, fill=WHITE)
    fl = fans()
    colw = (cw_ - 16) // 3
    for i, (lab, (rpm, pwm)) in enumerate(zip(("D1", "D2", "CPU"), fl)):
        fx = x + 9 + i * colw
        if i:
            d.line([(fx - 5, ROW2_T + 21), (fx - 5, ROW2_T + 53)], fill=DIVIDER)
        d.text((fx, ROW2_T + 22), lab, font=f_tiny, fill=WHITE)
        d.text((fx, ROW2_T + 30), f"{rpm if rpm is not None else 0}",
               font=f_fan, fill=GREEN if rpm else RED)
        d.text((fx, ROW2_T + 46), "rpm", font=f_tiny, fill=GREY)
    d.line([(x + 9, ROW2_T + 57), (x + cw_ - 9, ROW2_T + 57)], fill=DIVIDER)
    ic_clock(x + 10, ROW2_T + 62)
    d.text((x + 23, ROW2_T + 61), f"up {uptime()}", font=f_lbl, fill=WHITE)

    # ---- row 3: one card per drive --------------------------------------
    if dr:
        n = min(len(dr), 12)
        g = 4
        dw = (total_w - g * (n - 1)) / n
        for i, (name, temp, health) in enumerate(dr[:n]):
            x = M + i * (dw + g)
            failing = health == "bad"
            card((x, ROW3_T, x + dw, ROW3_B),
                 RED_CARD if failing else CARD, RED_EDGE if failing else CARD_EDGE)
            hc = HEALTH_COL.get(health, GREY)
            d.ellipse([x + 7, ROW3_T + 9, x + 13, ROW3_T + 15], fill=hc)
            d.text((x + 17, ROW3_T + 7), name, font=f_lbl, fill=WHITE)
            tc = temp_col(name, temp)
            tv = f"{temp}" if temp is not None else "--"
            d.text((x + 11, ROW3_T + 21), tv, font=f_drive, fill=tc)
            d.text((x + 13 + tw(tv, f_drive), ROW3_T + 27), "°C",
                   font=f_tiny, fill=tc)
            warm, hot = drive_limits(name)
            frac = 0 if temp is None else max(.06, min(1.0, temp / (hot + 8)))
            bar(x + 8, ROW3_B - 11, dw - 16, 4, frac, tc)
    return img


def blit(img):
    img = img.transpose(ROTATE)
    raw = img.tobytes("raw", "BGRX")
    row = PW * BPP
    with open(FB, "r+b", buffering=0) as fh:
        for y in range(PH):
            fh.seek(y * STRIDE)
            fh.write(raw[y * row:(y + 1) * row])


if __name__ == "__main__":
    once = "--once" in sys.argv
    dr, tick = drives(), 0
    cpu_busy()
    while True:
        try:
            if tick % SMART_EVERY == 0 and tick:
                dr = drives()
            blit(frame(dr))
        except Exception as e:
            print("err:", e, flush=True)
        if once:
            break
        tick += 1
        time.sleep(INTERVAL)
