#!/usr/bin/env python3
"""Render system stats to the Zettlab front LCD (eDP-1, 172x640 portrait).

Layout: header (host / clock / IP), a stats band (storage gauge, CPU, memory,
fans), and a per-drive strip showing SMART health and temperature. Drives are
discovered at runtime, so the strip scales from one disk to a fully populated
8-bay chassis plus NVMe.
"""
import glob, os, re, socket, subprocess, sys, time
from PIL import Image, ImageDraw, ImageFont

FB = "/dev/fb0"
PW, PH, STRIDE, BPP = 172, 640, 704, 4      # panel is portrait
CW, CH = PH, PW                              # canvas is landscape 640x172
ROTATE = Image.ROTATE_270                    # flip to ROTATE_90 if upside down
INTERVAL = 5
SMART_EVERY = 24                             # smartctl is slow; ~2 min between polls

MONO = "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf"
SANS = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
n_xl = ImageFont.truetype(MONO, 26)
n_lg = ImageFont.truetype(MONO, 20)
n_md = ImageFont.truetype(MONO, 17)
n_sm = ImageFont.truetype(MONO, 14)
l_sm = ImageFont.truetype(SANS, 12)
l_xs = ImageFont.truetype(SANS, 10)

BG      = (9, 11, 16)
CARD    = (20, 24, 33)
CARD_HI = (32, 37, 50)
LABEL   = (118, 126, 145)
TEXT    = (226, 230, 240)
ACCENT  = (86, 160, 255)
OK      = (72, 210, 140)
WARN    = (255, 176, 58)
BAD     = (255, 88, 82)
UNKNOWN = (110, 116, 132)

HEAD = (6, 4, 634, 32)                       # header card
BODY = (6, 36, 634, 116)                     # stats card
FOOT = (6, 120, 634, 168)                    # drive strip card

REAL_FS = {"ext4", "ext3", "xfs", "btrfs", "zfs", "f2fs", "jfs", "reiserfs"}

# SMART attributes that mean "this disk is degrading" when non-zero
BAD_ATTRS = {"5": "reallocated", "197": "pending", "198": "uncorrectable"}


def hwmon_named(name):
    for d in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        try:
            if open(os.path.join(d, "name")).read().strip() == name:
                yield d
        except OSError:
            pass


HW = next(hwmon_named("zettlab_d8_fans"), None)


def read_int(p):
    try:
        return int(open(p).read().strip())
    except Exception:
        return None


def cpu_temp():
    for d in hwmon_named("coretemp"):
        v = read_int(os.path.join(d, "temp1_input"))
        if v:
            return v / 1000.0
    return None


_prev_cpu = None


def cpu_busy():
    global _prev_cpu
    vals = [int(x) for x in open("/proc/stat").readline().split()[1:8]]
    idle, total = vals[3] + vals[4], sum(vals)
    if _prev_cpu is None:
        _prev_cpu = (idle, total)
        return 0.0
    di, dt = idle - _prev_cpu[0], total - _prev_cpu[1]
    _prev_cpu = (idle, total)
    return 0.0 if dt <= 0 else max(0.0, min(100.0, 100.0 * (dt - di) / dt))


def fans():
    if not HW:
        return []
    return [(read_int(f"{HW}/fan{n}_input"), read_int(f"{HW}/pwm{n}")) for n in (1, 2, 3)]


# ---------------------------------------------------------------- drives

def discover():
    """Every real block device, found at runtime — never a fixed list."""
    devs = []
    for path in sorted(glob.glob("/dev/sd[a-z]")):
        devs.append((path, os.path.basename(path)))          # sda, sdb, ...
    for path in sorted(glob.glob("/dev/nvme[0-9]n[0-9]")):
        m = re.search(r"nvme(\d+)n", path)
        devs.append((path, f"nv{m.group(1)}" if m else os.path.basename(path)))
    return devs


_last = {}          # name -> (temp, health) so a sleeping disk keeps its reading


def probe(path, name):
    """Return (temp, health) with health in ok / warn / bad / unknown."""
    try:
        r = subprocess.run(["smartctl", "-H", "-A", "-n", "standby", path],
                           capture_output=True, text=True, timeout=12)
    except Exception:
        return _last.get(name, (None, "unknown"))

    out = r.stdout
    if "STANDBY" in out.upper() and "Device is in" in out:
        return _last.get(name, (None, "unknown"))           # asleep, do not wake it

    temp, health = None, "unknown"

    if re.search(r"self-assessment test result:\s*PASSED", out):
        health = "ok"
    elif re.search(r"self-assessment test result:\s*FAILED", out) or \
            re.search(r"SMART Health Status:\s*FAILED", out):
        health = "bad"
    elif re.search(r"SMART overall-health.*OK", out) or "SMART Health Status: OK" in out:
        health = "ok"

    for line in out.splitlines():
        p = line.split()
        # SATA attribute table: ID# NAME FLAG VAL WORST THRESH TYPE UPDATED WHEN RAW
        if len(p) >= 10 and p[0].isdigit():
            if p[0] in ("194", "190") and temp is None:
                try:
                    temp = int(p[9])
                except ValueError:
                    pass
            if p[0] in BAD_ATTRS and health == "ok":
                try:
                    if int(p[9].split()[0]) > 0:
                        health = "warn"
                except ValueError:
                    pass
        # NVMe key/value block
        if temp is None and line.startswith("Temperature:"):
            m = re.search(r"(\d+)\s*Celsius", line)
            if m:
                temp = int(m.group(1))
        if line.startswith("Critical Warning:") and health == "ok":
            if line.split(":")[1].strip() not in ("0x00", "0"):
                health = "warn"
        if line.startswith("Media and Data Integrity Errors:") and health == "ok":
            if line.split(":")[1].strip().replace(",", "") not in ("0",):
                health = "warn"

    if temp is None:
        temp = _last.get(name, (None, None))[0]
    _last[name] = (temp, health)
    return temp, health


def drives():
    return [(name, *probe(path, name)) for path, name in discover()]


def temp_state(name, temp):
    """Colour a temperature: NVMe runs hotter than spinning rust by design."""
    if temp is None:
        return UNKNOWN
    warm, hot = (60, 72) if name.startswith("nv") else (47, 55)
    return BAD if temp >= hot else WARN if temp >= warm else OK


HEALTH_COL = {"ok": OK, "warn": WARN, "bad": BAD, "unknown": UNKNOWN}


# ---------------------------------------------------------------- system

def storage():
    used = total = 0
    seen = set()
    for line in open("/proc/mounts"):
        parts = line.split()
        if len(parts) < 3 or parts[2] not in REAL_FS:
            continue
        try:
            st = os.statvfs(parts[1])
        except OSError:
            continue
        key = (st.f_blocks, st.f_frsize, st.f_fsid)
        if not st.f_blocks or key in seen:
            continue
        seen.add(key)
        total += st.f_blocks * st.f_frsize
        used += (st.f_blocks - st.f_bfree) * st.f_frsize
    return used, total


def human(n):
    return f"{n / 1e12:.1f}TB" if n >= 1e12 else f"{n / 1e9:.0f}GB"


def mem():
    m = {}
    for line in open("/proc/meminfo"):
        k, v = line.split(":", 1)
        m[k] = int(v.split()[0])
    total = m["MemTotal"]
    avail = m.get("MemAvailable", m["MemFree"])
    return (total - avail) / 1048576.0, total / 1048576.0


def ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("192.168.0.1", 80))
        a = s.getsockname()[0]
        s.close()
        return a
    except Exception:
        return "-"


def uptime():
    s = int(float(open("/proc/uptime").read().split()[0]))
    d, s = divmod(s, 86400)
    h, s = divmod(s, 3600)
    return f"{d}d {h}h" if d else f"{h}h {s // 60}m"


def heat(t, warm, hot):
    if t is None:
        return UNKNOWN
    return BAD if t >= hot else WARN if t >= warm else OK


# ---------------------------------------------------------------- render

def frame(dr):
    img = Image.new("RGB", (CW, CH), BG)
    d = ImageDraw.Draw(img)

    def ctext(cx, y, txt, font, fill):
        d.text((cx - d.textlength(txt, font=font) / 2, y), txt, font=font, fill=fill)

    def rtext(x, y, txt, font, fill):
        d.text((x - d.textlength(txt, font=font), y), txt, font=font, fill=fill)

    def meter(x, y, w, h, frac, col):
        d.rounded_rectangle([x, y, x + w, y + h], radius=h // 2, fill=CARD_HI)
        fw = int(w * max(0.0, min(frac, 1.0)))
        if fw > h:
            d.rounded_rectangle([x, y, x + fw, y + h], radius=h // 2, fill=col)
        elif fw > 0:
            d.ellipse([x, y, x + h, y + h], fill=col)

    for card in (HEAD, BODY, FOOT):
        d.rounded_rectangle(card, radius=9, fill=CARD)

    # ---- header: host + health badge | clock | ip ------------------------
    host = socket.gethostname()
    d.text((16, 8), host, font=n_lg, fill=ACCENT)
    if dr:
        bad = sum(1 for _, _, h in dr if h == "bad")
        warn = sum(1 for _, _, h in dr if h == "warn")
        msg = (f"{bad} FAILING" if bad else
               f"{warn} WARNING" if warn else f"{len(dr)} OK")
        col = BAD if bad else WARN if warn else OK
        bx = 16 + d.textlength(host, font=n_lg) + 12
        bw = d.textlength(msg, font=l_xs) + 14
        d.rounded_rectangle([bx, 11, bx + bw, 26], radius=7, fill=CARD_HI)
        d.text((bx + 7, 14), msg, font=l_xs, fill=col)
    ctext(CW // 2, 7, time.strftime("%H:%M"), n_xl, TEXT)
    rtext(CW - 16, 10, ip(), n_md, TEXT)

    # ---- body left: storage gauge ---------------------------------------
    used, total = storage()
    frac = used / total if total else 0
    cx, cy, r = 66, 74, 30
    box = [cx - r, cy - r, cx + r, cy + r]
    d.arc(box, 130, 410, fill=CARD_HI, width=8)
    if frac > 0:
        col = BAD if frac > .9 else WARN if frac > .75 else ACCENT
        d.arc(box, 130, 130 + int(280 * frac), fill=col, width=8)
    ctext(cx, cy - 12, f"{frac * 100:.0f}%", n_md, TEXT)
    ctext(cx, 44, "STORAGE", l_xs, LABEL)
    ctext(cx, 104, f"{human(used)} / {human(total)}", l_xs, LABEL)

    # ---- body middle: cpu + memory --------------------------------------
    x0, x1 = 120, 404
    ct, busy = cpu_temp(), cpu_busy()
    cv = f"{ct:.0f}C" if ct else "--"
    d.text((x0, 48), "CPU", font=l_sm, fill=LABEL)
    d.text((x0 + 40, 44), cv, font=n_lg, fill=heat(ct, 70, 85))
    rtext(x1, 46, f"{busy:.0f}%", n_md, TEXT)
    meter(x0, 68, x1 - x0, 6, busy / 100, ACCENT)

    mu, mt = mem()
    d.text((x0, 84), "MEM", font=l_sm, fill=LABEL)
    d.text((x0 + 40, 80), f"{mu:.1f}/{mt:.0f}G", font=n_lg, fill=TEXT)
    rtext(x1, 82, f"{100 * mu / mt:.0f}%", n_md, TEXT)
    meter(x0, 104, x1 - x0, 6, mu / mt, OK)

    # ---- body right: fans + uptime --------------------------------------
    fx = 420
    d.text((fx, 44), "FANS", font=l_xs, fill=LABEL)
    for lab, (rpm, pwm), px in zip(("D1", "D2", "CPU"),
                                   fans() or [(None, None)] * 3,
                                   (fx, fx + 72, fx + 144)):
        col = OK if rpm else BAD
        d.text((px, 58), lab, font=l_xs, fill=LABEL)
        d.text((px, 70), f"{rpm if rpm is not None else 0}", font=n_sm, fill=col)
        d.text((px, 88), f"pwm {pwm if pwm is not None else 0}", font=l_xs, fill=LABEL)
    d.text((fx, 104), f"up {uptime()}", font=l_xs, fill=LABEL)

    # ---- footer: one cell per drive, auto-sized --------------------------
    if dr:
        pad, top = 14, FOOT[1]
        avail = (FOOT[2] - FOOT[0]) - pad * 2
        cell = max(40, min(72, avail // max(1, len(dr))))
        for i, (name, temp, health) in enumerate(dr[:12]):
            px = FOOT[0] + pad + i * cell
            hc = HEALTH_COL.get(health, UNKNOWN)
            d.ellipse([px, top + 10, px + 7, top + 17], fill=hc)
            d.text((px + 12, top + 8), name, font=l_xs, fill=LABEL)
            tv = f"{temp}" if temp is not None else "--"
            d.text((px + 12, top + 22), tv, font=n_sm, fill=temp_state(name, temp))
    return img


def blit(img):
    img = img.transpose(ROTATE)                       # -> 172x640
    raw = img.tobytes("raw", "BGRX")                  # i915 XRGB8888 LE
    row = PW * BPP
    with open(FB, "r+b", buffering=0) as fh:
        for y in range(PH):
            fh.seek(y * STRIDE)
            fh.write(raw[y * row:(y + 1) * row])


if __name__ == "__main__":
    once = "--once" in sys.argv
    dr, tick = drives(), 0
    cpu_busy()
    while True:
        try:
            if tick % SMART_EVERY == 0 and tick:
                dr = drives()
            blit(frame(dr))
        except Exception as e:
            print("err:", e, flush=True)
        if once:
            break
        tick += 1
        time.sleep(INTERVAL)
