#!/usr/bin/env python3
"""Grab the front LCD framebuffer to a PNG."""
import sys
from PIL import Image
PW, PH, STRIDE, BPP = 172, 640, 704, 4
out = sys.argv[1] if len(sys.argv) > 1 else "/tmp/lcd.png"
row = PW * BPP
buf = bytearray()
with open("/dev/fb0", "rb") as f:
    for y in range(PH):
        f.seek(y * STRIDE)
        buf += f.read(row)
img = Image.frombytes("RGB", (PW, PH), bytes(buf), "raw", "BGRX")
img = img.transpose(Image.ROTATE_90)     # back to landscape as the eye sees it
img.save(out)
print("saved", out, img.size)
